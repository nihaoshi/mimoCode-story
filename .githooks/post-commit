#!/bin/sh
# post-commit hook for mimocode-story writing projects
# Reminds to update tracking files after committing chapters

COMMIT_MSG=$(git log -1 --pretty=%s)

# Check if a chapter was committed
if echo "$COMMIT_MSG" | grep -qE "^Ch[0-9]+"; then
  echo ""
  echo "Chapter committed: $COMMIT_MSG"
  echo ""
  echo "Reminder: please confirm these tracking files have been updated:"
  echo "  - 追踪/伏笔.md"
  echo "  - 追踪/时间线.md"
  echo "  - 追踪/角色状态.md"
  echo "  - 追踪/物品.md"
  echo "  - 追踪/环境.md"
  echo "  - 追踪/上下文.md"
  echo ""
  echo "For a full review, run /story-review"
  echo ""
fi
