#!/bin/sh
# pre-commit hook for mimocode-story writing projects
# Checks: file format, banned words, chapter file size

echo "Running pre-commit checks..."

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check chapter files
for FILE in $STAGED_FILES; do
  case "$FILE" in
    */正文/第*章*.md|正文/第*章*.md)
      # Check file size (should be > 500 bytes for a real chapter)
      SIZE=$(wc -c < "$FILE" 2>/dev/null || echo 0)
      if [ "$SIZE" -lt 500 ]; then
        echo "WARNING: $FILE is too small ($SIZE bytes), content may be incomplete"
      fi

      # Check for basic chapter structure
      if ! grep -q "^#" "$FILE" 2>/dev/null; then
        echo "WARNING: $FILE is missing a title (line starting with #)"
      fi
      ;;
  esac
done

# Check tracking files exist when chapters exist
if ls */正文/第*章*.md 正文/第*章*.md 1>/dev/null 2>&1; then
  if [ ! -d "*/追踪" ] && [ ! -d "追踪" ]; then
    echo "ERROR: Chapters exist but no tracking directory found. Run /story-setup first."
    exit 1
  fi
fi

echo "Pre-commit checks passed"
exit 0
