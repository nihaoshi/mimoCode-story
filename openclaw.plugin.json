{
  "name": "mimocode-story",
  "version": "3.3.0",
  "description": "MiMo Code 网文写作技能包。覆盖长篇与短篇网络小说的扫榜、拆文、写作、去AI味、审稿全流程。",
  "family": "bundle-plugin",
  "configSchema": {
    "version_control": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "是否启用 Git 版本控制。关闭后不会自动提交、不会创建 hooks。"
    },
    "auto_checkpoint": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "是否启用自动检查点保存。"
    },
    "parallel_chapters": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "是否启用并行章节处理（需要 compose 模式）。"
    }
  },
  "skills": [
    "skills/story-mimo",
    "skills/story-setup-mimo",
    "skills/story-long-write-mimo",
    "skills/story-short-write-mimo",
    "skills/story-long-analyze-mimo",
    "skills/story-short-analyze-mimo",
    "skills/story-long-scan-mimo",
    "skills/story-short-scan-mimo",
    "skills/story-scan-mimo",
    "skills/story-import-mimo",
    "skills/story-deslop-mimo",
    "skills/story-review-mimo",
    "skills/story-cover-mimo",
    "skills/browser-cdp-mimo",
    "skills/story-synopsis-mimo",
    "skills/story-export-mimo",
    "skills/audit-mimo",
    "skills/quality-mimo",
    "skills/project-health-mimo",
    "skills/distill-mimo",
    "skills/dream-mimo",
    "skills/goal-mimo",
    "skills/story-session-mimo"
  ],
  "shared_deps": [
    "skills/_shared/references",
    "skills/_shared/templates",
    "skills/_shared/examples",
    "skills/_shared/checklists"
  ],
  "openclaw": {
    "compat": {}
  }
}
